[Unit]
Description=Kev %i native ROCm runtime
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=exec
User=@SERVICE_USER@
WorkingDirectory=@SERVICE_ROOT@
EnvironmentFile=/etc/kev-mcp/common.env
EnvironmentFile=/etc/kev-mcp/%i.env
ExecStart=/bin/bash @SERVICE_ROOT@/current/scripts/runtime-service.sh
ExecStartPost=@SERVICE_ROOT@/bridge-venv/bin/python @SERVICE_ROOT@/current/scripts/wait-runtime.py
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=120
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
